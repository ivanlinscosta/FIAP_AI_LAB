# ==========================================
# FIAP AI LAB - PROFESSOR ONLY
# ==========================================
# Never distribute this file after adding real secrets.

# Required: dedicated OpenAI API key for this lab project
OPENAI_API_KEY=PASTE_DEDICATED_OPENAI_PROJECT_KEY_HERE

# Generated by scripts/generate_secrets.py
LITELLM_MASTER_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# Gateway database
DATABASE_URL=postgresql://litellm:${POSTGRES_PASSWORD}@postgres:5432/litellm

# Public URL used by students. For local tests, use http://localhost:4000
GATEWAY_PUBLIC_URL=http://localhost:4000
N8N_PUBLIC_URL=http://localhost:5678

# n8n
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Lab provisioning defaults
GROUP_COUNT=10
GROUP_BUDGET_USD=5
GROUP_BUDGET_DURATION=30d
GROUP_RPM_LIMIT=30
GROUP_TPM_LIMIT=100000
GROUP_KEY_DURATION=45d

# Optional - change model aliases by editing litellm/config.yaml
FIAP_FAST_MODEL=gpt-5-mini
FIAP_STANDARD_MODEL=gpt-5.1
FIAP_EMBEDDING_MODEL=text-embedding-3-small

# Dashboard
ADMIN_USERNAME=professor
ADMIN_PASSWORD=CHANGE_ME
LITELLM_BASE_URL=http://localhost:4000
DASHBOARD_REFRESH_SECONDS=30
ADMIN_SESSION_TTL_SECONDS=43200
