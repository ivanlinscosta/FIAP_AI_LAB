{
  "swagger": "2.0",
  "info": {
    "title": "FIAP AI Gateway",
    "description": "Conector educacional para acessar o gateway OpenAI-compatible do laboratório FIAP sem expor a chave real da OpenAI.",
    "version": "1.0.0"
  },
  "host": "YOUR_GATEWAY_HOST",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [{"api_key": []}],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "CreateChatCompletion",
        "summary": "Gerar resposta com IA",
        "description": "Envia mensagens para um modelo liberado no FIAP AI Gateway.",
        "x-ms-summary": "Gerar resposta com IA",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["model", "messages"],
              "properties": {
                "model": {"type": "string", "default": "fiap-fast", "x-ms-summary": "Modelo"},
                "messages": {
                  "type": "array",
                  "x-ms-summary": "Mensagens",
                  "items": {
                    "type": "object",
                    "required": ["role", "content"],
                    "properties": {
                      "role": {"type": "string", "enum": ["system", "user", "assistant"]},
                      "content": {"type": "string"}
                    }
                  }
                },
                "temperature": {"type": "number", "format": "double", "default": 0.2},
                "max_tokens": {"type": "integer", "format": "int32", "default": 600}
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta do modelo",
            "schema": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "model": {"type": "string"},
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {"type": "integer"},
                      "message": {
                        "type": "object",
                        "properties": {
                          "role": {"type": "string"},
                          "content": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
